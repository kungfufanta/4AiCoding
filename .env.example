# 4AiCoding / sandboxd configuration. Copy to .env:
#   cp .env.example .env
# All values have sensible defaults; the stack runs with an empty .env.

# ── Preview routing ──────────────────────────────────────────────────
# Domain preview URLs hang off. "localhost" needs no DNS/TLS: browsers
# resolve *.localhost to 127.0.0.1, so previews work out of the box at
#   http://s-<id>-<port>.preview.localhost:${HTTP_PORT}
# For a public deployment, set a real wildcard domain and switch to TLS
# (see README "Production / TLS").
PREVIEW_DOMAIN=localhost
PREVIEW_ENTRYPOINT=web
PREVIEW_TLS=false
# Behind something ELSE that terminates TLS (Cloudflare Tunnel, Caddy, Nginx,
# a reverse tunnel)? Keep PREVIEW_TLS=false (Traefik stays plain HTTP) and set
# PREVIEW_URL_SCHEME=https so the API hands out https:// preview URLs. The proxy in front must listen on that scheme's default port
# (443 for https): with an explicit scheme, HTTP_PORT is not part of the URL.
# Empty = derived from PREVIEW_TLS.
PREVIEW_URL_SCHEME=

# Hostname layout under PREVIEW_DOMAIN.
#   nested (default)  s-<id>-<port>.preview.<domain>   console.<domain>   api.preview.<domain>
#   flat              s-<id>-<port>[--tag].<domain>    console[--tag].<domain>   api[--tag].<domain>
# With flat, one wildcard certificate *.<domain> covers every host
# (Cloudflare Universal SSL and similar cover only one level); the tag lets
# several sandboxd instances share one domain. PREVIEW_HOST_TAG is only used
# with flat and must match [a-z0-9][a-z0-9-]{0,30}. In flat mode each preview
# host authorises private previews separately (no shared session cookie).
PREVIEW_HOST_STYLE=nested
PREVIEW_HOST_TAG=

# Host port Traefik listens on. Use 80 on a dedicated host; pick another
# (e.g. 8080) if something already owns 80. Preview URLs then include it:
#   http://s-<id>-<port>.preview.localhost:8080
#
# macOS note — Rancher Desktop and Docker Desktop with k3s enabled bind
# port 80 via their built-in Traefik/klipper-lb before sandboxd's Traefik
# can claim it, so preview URLs silently 404. Use HTTP_PORT=8080 (or any
# free port) and restart: docker compose up -d traefik
HTTP_PORT=80

# ── Images & network ─────────────────────────────────────────────────
# Images are built locally (docker compose up --build; image/Dockerfile for
# the sandbox base). Override the names here if you build your own.
SANDBOXD_IMAGE=
SANDBOXD_CONTROL_PLANE_IMAGE=
SANDBOXD_NETWORK=sandboxd_net

# ── Per-sandbox spec limits (M3a; the admin policy replaces these in M3b) ─
# Images a sandbox may request besides SANDBOXD_IMAGE (comma separated).
# Empty = only the instance image.
SANDBOXD_IMAGE_ALLOWLIST=
# uid:gid every sandbox process runs as, whatever the image's USER says.
SANDBOXD_SANDBOX_USER=1000:1000
# Hard memory limit when a sandbox asks for none, and the clamp maximum.
SANDBOXD_DEFAULT_MEMORY_MB=10240
SANDBOXD_MAX_MEMORY_MB=10240
# Clamp for resources.cpus (0 = no clamp) and preview ports per sandbox.
SANDBOXD_MAX_CPUS=0
SANDBOXD_MAX_PORTS_PER_SANDBOX=16
# Open-files limit inside each sandbox (lower it on nested Docker hosts).
SANDBOXD_SANDBOX_NOFILE=65536

# ── Runtime (gVisor, opt-in) ─────────────────────────────────────────
# Container runtime for sandboxes. Empty = Docker default (runc).
# Set "runsc" to run every sandbox under gVisor for stronger kernel
# isolation. Requires runsc installed + registered in daemon.json with
# runtimeArgs ["--host-uds=create"]. See docs/gvisor.md.
SANDBOXD_RUNTIME=
# Resolvers for sandboxes (CSV). Only used when SANDBOXD_RUNTIME=runsc
# (gVisor can't reach Docker's embedded DNS). Default: 1.1.1.1,8.8.8.8
SANDBOXD_DNS=

# ── Storage ──────────────────────────────────────────────────────────
# Workspaces, SQLite state and the shared access log live here. MUST be
# an absolute path; it is bind-mounted host:container symmetric (see
# docker-compose.yml). NOTE: the OSS build stores each workspace as a
# plain directory — there is NO hard per-workspace disk quota.
SANDBOXD_DATA_DIR=/var/lib/sandboxd
SANDBOXD_LOG_DIR=/var/lib/sandboxd/log

# Where the control-plane API is published on the host. The default
# avoids the common 9000 clash; the upstream backend / your scripts talk
# to it here. Set to e.g. 0.0.0.0:9090 to expose on the LAN (then you
# SHOULD enable auth below).
SANDBOXD_API_BIND=127.0.0.1:9090

# ── API auth (sandboxd /v1) ──────────────────────────────────────────
# ON by default. Every /v1 request needs a session or a bearer API key —
# uniformly, with no loopback bypass. SANDBOXD_API_TOKENS is the env
# "bootstrap" key (NAME=VALUE, comma-separated):
#   SANDBOXD_API_TOKENS=default=sk_...      # generate with: openssl rand -hex 32
# Rotate it by editing this line (SIGHUP reloads it) or mint a key via
# POST /v1/api-keys. Set SANDBOXD_API_AUTH_DISABLED=true only for local
# experiments: it opens the whole API.
SANDBOXD_API_AUTH_DISABLED=false
SANDBOXD_API_TOKENS=

# Console users (admin / operator / viewer) live in SQLite with bcrypt
# passwords. The first admin comes from here ("username:password", used
# only while no user exists) or from the console's first-run setup page.
SANDBOXD_BOOTSTRAP_ADMIN=
# Cap on API key lifetimes in seconds (0 = keys may be permanent). When set,
# a key created without ttl_seconds gets this lifetime.
SANDBOXD_API_KEY_MAX_TTL_SECONDS=0

# ── Worker fleet (M6) ────────────────────────────────────────────────
# The control plane is itself a node (role 'local', id SANDBOXD_NODE_ID,
# default "local"). Remote workers join with the same binary in worker
# mode and authenticate with this bearer token:
#
#   sandboxd worker --control-plane-url http://<cp>:9000 \
#     --worker-token $SANDBOXD_WORKER_TOKEN --node-id worker-1 \
#     --capacity-cpus 8 --capacity-memory-mb 16384
#
# Workers heartbeat every 10s and go "offline" in the fleet view after
# SANDBOXD_NODE_LEASE_SECONDS of silence (default 90). Draining a node
# (POST /v1/nodes/{id}/drain, admin) refuses NEW sandboxes there.
# Leave SANDBOXD_WORKER_TOKEN empty to keep the fleet door closed.
SANDBOXD_WORKER_TOKEN=
SANDBOXD_NODE_ID=
SANDBOXD_NODE_LEASE_SECONDS=
# Capacity the control plane reports for itself (defaults: NumCPU, MemTotal).
SANDBOXD_CAPACITY_CPUS=
SANDBOXD_CAPACITY_MEMORY_MB=
SANDBOXD_CAPACITY_DISK_MB=

# ── Sandbox egress (PLAN §8 #5) ──────────────────────────────────────
# Sandboxes sit on an internal network with no route out; the only way out
# is sandboxd's HTTP/CONNECT proxy, which allows a destination only if it is
# on that sandbox's allowlist (PUT /v1/sandboxes/{id}/network/egress), which
# in turn must fit the instance policy (PUT /v1/policy/egress). Loopback,
# link-local (cloud metadata) and private addresses are always refused
# unless an exact private IP is allowlisted.
SANDBOXD_EGRESS_PROXY_ADDR=:3128
SANDBOXD_EGRESS_PROXY_URL=http://sandboxd-egress:3128
# false = give sandboxes direct, unfiltered internet (the proxy is then advisory).
SANDBOXD_NETWORK_INTERNAL=true

# Master key for encrypting sensitive app config/secrets at rest
# (base64 of 32 bytes). Leave empty to auto-generate a 0600 keyfile at
# <data dir>/secrets.key. Back this up — losing it makes secrets
# unrecoverable; treat it as sensitive as the secrets themselves.
SANDBOXD_SECRETS_KEY=

# ── Resource policy (advanced) ───────────────────────────────────────
# Write cgroup v2 memory.high after start (soft throttle). Needs host
# cgroup access the control-plane container usually lacks, so it is OFF
# by default; the hard --memory ceiling on each sandbox still applies.
SANDBOXD_SET_MEMORY_HIGH=false

# Idle window before a sandbox is stopped (docker stop) to free RAM.
# 2100s = 35 min. Workspace is preserved; next request wakes it.
SANDBOXD_IDLE_THRESHOLD_SECONDS=2100

# ── Observability (Phase 5) ──────────────────────────────────────────
# The durable activity timeline (app_events table) is append-only and
# lives in the control-plane SQLite DB. Retention is NOT pruned yet; the
# table is small at current volume. Future knob (not implemented):
#   SANDBOXD_EVENT_RETENTION_DAYS  — delete app_events older than N days.
# Until then the timeline grows unbounded; that's fine for current use.

